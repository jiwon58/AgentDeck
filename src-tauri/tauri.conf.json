{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Deck", "version": "0.1.7", "identifier": "local.agentdeck.desktop",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://127.0.0.1:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {"windows":[{"label":"main","title":"Agent Deck","width":1280,"height":820,"minWidth":850,"minHeight":560}],
